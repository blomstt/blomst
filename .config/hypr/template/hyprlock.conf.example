# Lock screen. Colours come from the wallpaper via matugen (hyprlock-colors.conf).
# Keep exactly one wallpaper line in the background block: the wallpaper picker rewrites it.
source = ~/.config/hypr/service/hyprlock-colors.conf

background {
    monitor =
    path = 
    blur_passes = 2
    blur_size = 3
    noise = 0.02
    contrast = 0.9
    brightness = 0.55
    vibrancy = 0.2
    vibrancy_darkness = 0.2
}

# Clock
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = $lock_text
    font_size = 96
    font_family = Iosevka
    shadow_passes = 2
    shadow_size = 4
    position = 0, 170
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A %-d %B"
    color = $lock_dim
    font_size = 20
    font_family = Iosevka
    shadow_passes = 2
    shadow_size = 3
    position = 0, 70
    halign = center
    valign = center
}

# Password
input-field {
    monitor =
    size = 280, 48
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = $lock_accent
    inner_color = $lock_field
    font_color = $lock_text
    check_color = $lock_accent
    fail_color = $lock_fail
    fade_on_empty = true          # hidden until you start typing
    fade_timeout = 1500           # ms before it hides again once emptied
    placeholder_text =
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>
    fail_timeout = 2000
    fail_transition = 300
    rounding = -1
    font_family = Iosevka
    position = 0, -50
    halign = center
    valign = center
}

# Who
label {
    monitor =
    text = $USER
    color = $lock_dim
    font_size = 14
    font_family = Iosevka
    position = 0, -110
    halign = center
    valign = center
}
