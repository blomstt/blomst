@import "rofi-dark-colors.rasi"

/**
 * Abuku Color Theme
 * User: Abuku
 * Copyright: Hayya U
 */


configuration {
    modi:                       "drun,run";
    font:                       "Iosevka 14";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    application-fallback-icon:  "application-x-executable";   /* apps without their own icon */
    display-drun:               "∂";
    display-run:                "∂";
    display-filebrowser:        "FILES";
    display-window:             "WINDOW";
    drun-display-format:        "{name} [<span weight='light' size='small' alpha='65%'>  {generic}</span>]";
    hover-select:               false;
    scroll-method:              1;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    
}

window {
    width:                        520px;
    x-offset:                     0px;
    y-offset:                     0px;
    spacing:                      0px;
    padding:                      10px;
    margin:                       0px; 
    border:                       0px;
    border-color:                 transparent;
    cursor:                       "default";
    transparency:                 "real";
    location:                     center;
    anchor:                       center;
    fullscreen:                   false;
    enabled:                      true;
    border-radius:                12px;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 2px;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}


prompt {
    padding: 0 5px 0 5px;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: 2px;
    border-radius: 8px;
    padding: 4px;
}

entry {
    placeholder: "find the zen";
    padding: 2px;
}

mainbox {
    spacing: 4px;
    margin: 0;
    padding: 0;
    children: ["inputbar", "listview", "message"];
}

listview{
    border-radius: 8px;
}

element {
    children: ["element-icon", "element-text"];
    spacing: 12px;
    margin: 0;
    padding: 7px 10px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal {
	background-color: transparent;
}

element alternate.normal {
	background-color: transparent;
}

element selected.active {
	text-color: @selected-active-foreground;
}

element selected.normal {
	text-color: @selected-normal-foreground;
}

