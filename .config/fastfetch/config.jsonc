{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "key": {
      "width": 7
    },
    "color": {
      "title": "cyan",
      "keys": "cyan",
      "separator": "dim_white",
      "output": "default"
    }
  },
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logos/frog.txt",
    "width": 16,
    "height": 9,
    "padding": {
      "top": 0,
      "left": 4,
      "right": 5
    }
  },
  "modules": [
    {
      "type": "break"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{2}"
    },
    {
      "type": "command",
      "key": "KERN",
      "text": "uname -r | sed -E 's/^([0-9]+\\.[0-9]+\\.[0-9]+).*/\\1/'"
    },
    {
      "type": "uptime",
      "key": "UP",
      "format": "{?1}{1}d {?}{?2}{2}h {?}{3}m"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "hideType": "integrated"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
