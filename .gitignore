# Autogenerated Directories
.local/share/icons/hicolor/
.config/hypr/user/

# Autogenerated Files
.config/hypr/service/hyprlock.conf
.config/hypr/service/hyprpaper.conf

# Colors
.config/eww/colors.scss
.config/kitty/kitty-colors.conf
.config/nvim/colors/lush-colors.json
.config/nvim/colors/vim-colors.vim
.config/rofi/rofi-dark-colors.rasi

# Wallpaper Preview
wallpapers/preview-*.jpg

# Zsh
.zshrc
.zshenv

# Colours generated from the wallpaper
.config/hypr/service/hyprlock-colors.conf
.config/yazi/theme.toml

# Backups, logs and caches
*.bak
*.bak-*
*.backup
install-log.txt
__pycache__/

# Personal player state (listening queue)
.config/ncspot/userstate.cbor

# Per-machine extras
.config/matugen/local.toml
.config/matugen/templates-local/
.config/ncspot/

# Editor and tool leftovers
*.save
.config/yazi/*-[0-9]*

# Only the default wallpaper ships with the repo; add your own to ~/wallpapers
wallpapers/*
!wallpapers/15.jpg

# Remembered floating size for kitty (per machine)
.config/kitty/float-size.conf
